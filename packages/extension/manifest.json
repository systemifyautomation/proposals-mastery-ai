{
  "manifest_version": 3,
  "name": "Proposals Mastery AI",
  "version": "0.1.0",
  "description": "Analyze Upwork job descriptions and generate winning cover letters using your templates",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://www.upwork.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.upwork.com/jobs/*"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
