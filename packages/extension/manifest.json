{
  "manifest_version": 3,
  "name": "Proposals Mastery AI",
  "version": "0.1.0",
  "description": "Analyze Upwork job descriptions and generate winning cover letters using your templates",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "identity",
    "downloads",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://www.upwork.com/*",
    "https://www.googleapis.com/*"
  ],
  "oauth2": {
    "client_id": "YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/youtube.upload"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "settings.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "all_frames": false,
      "run_at": "document_end"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
